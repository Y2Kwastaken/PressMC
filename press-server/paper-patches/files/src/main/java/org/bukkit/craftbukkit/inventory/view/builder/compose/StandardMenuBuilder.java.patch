+package org.bukkit.craftbukkit.inventory.view.builder.compose;
+
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.world.inventory.MenuType;
+import net.minecraft.world.level.block.entity.ChestBlockEntity;
+
+final class StandardMenuBuilder implements MenuBuilder<MenuContext.None> {
+
+    private final MenuType<?> menuType;
+
+    StandardMenuBuilder(MenuType<?> menuType) {
+        this.menuType = menuType;
+    }
+
+    @Override
+    public Created create(final ServerPlayer player, final MenuContext.None context) {
+        return new Created(
+                this.menuType.create(player.nextContainerCounter(), player.getInventory()),
+                ChestBlockEntity.DEFAULT_NAME
+        );
+    }
+}
